# Virtual Ink server-only defaults. Health/tests need no credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
AUTH_ENABLED=false
# Enable only after Phase 2 migration + restricted login + pg installation.

# Optional infrastructure; use a least-privilege login, not the migration owner.
DATABASE_PROVIDER=supabase
DATABASE_CONNECTION_MODE=session
MIGRATION_CONNECTION_MODE=direct
# Supabase is the initial hosted provider. Leaving URLs unset keeps health local.
# SUPABASE_PROJECT_REF=odgxcuwueessxfsoveza
# SUPABASE_URL=https://odgxcuwueessxfsoveza.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# DATABASE_SSL_ROOT_CERT=D:/private-certs/supabase-ca.crt
# Copy endpoints from the Supabase Dashboard Connect panel; do not invent hosts.
# Append sslmode=verify-full to hosted URLs and configure the CA certificate.
# DATABASE_URL=YOUR_RESTRICTED_SESSION_CONNECTION_URL
# MIGRATION_DATABASE_URL=YOUR_DIRECT_MIGRATION_CONNECTION_URL
# Auth, storage clients and hosted migrations are not enabled by config alone.
# For the existing local Docker database scripts, set DATABASE_PROVIDER=postgres
# and DATABASE_CONNECTION_MODE=direct instead, using the examples below.
# POSTGRES_PASSWORD=REPLACE_LOCAL_DEVELOPMENT_PASSWORD
# DATABASE_URL=postgresql://virtual_ink_worker_login:REPLACE_PASSWORD@127.0.0.1:55432/virtual_ink_development
# MIGRATION_DATABASE_URL=postgresql://virtual_ink_migration_owner:REPLACE_PASSWORD@127.0.0.1:55432/virtual_ink_development
# TEST_DATABASE_URL=postgresql://TEST_OWNER:REPLACE_PASSWORD@127.0.0.1:55432/virtual_ink_test
JOBS_ENABLED=false
STORAGE_ENABLED=false
# Private S3-compatible bucket contract. File routes remain disabled.
# S3_ENDPOINT=https://YOUR_PRIVATE_STORAGE_ENDPOINT
# S3_REGION=YOUR_REGION
# S3_BUCKET=YOUR_PRIVATE_BUCKET
# S3_ACCESS_KEY_ID=REPLACE_SERVER_ONLY_KEY
# S3_SECRET_ACCESS_KEY=REPLACE_SERVER_ONLY_SECRET
# Never use NEXT_PUBLIC_ for credentials, database URLs or storage settings.
# Supabase publishable keys may be used by a future auth client; secret/service
# role keys must never be exposed. This foundation needs no elevated API key.
