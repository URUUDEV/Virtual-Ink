# Server-only Next.js settings. Copy privately to apps/web/.env.local.
# Health/public preview work with both switches off. No demo login is substituted.
WEB_AUTH_ENABLED=false
# APP_SERVICE_URL is generated by the web -> app binding; never set it yourself.
AUTH_ENABLED=false
APP_ORIGIN=http://127.0.0.1:3001
DATABASE_PROVIDER=supabase
DATABASE_CONNECTION_MODE=session
MIGRATION_CONNECTION_MODE=direct
# SUPABASE_URL=https://odgxcuwueessxfsoveza.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_MODERN_PUBLISHABLE_KEY
# DATABASE_URL=YOUR_RESTRICTED_API_SESSION_CONNECTION_URL
# DATABASE_SSL_ROOT_CERT=D:/private-certs/supabase-ca.crt
# Never put provisioning/migration credentials or NEXT_PUBLIC secrets here.
# Vercel: exact HTTPS APP_ORIGIN per Preview/Production, private database login,
# verified CA available to the server. Allow APP_ORIGIN/auth/callback in Auth.
