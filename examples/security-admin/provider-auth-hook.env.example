# Dedicated self-hosted Supabase Auth configuration, never the Vercel web app.
# Managed Supabase configures the equivalent hook through Auth Hooks; current
# managed availability is Teams/Enterprise. No plan or billing change is implied.
GOTRUE_HOOK_MFA_VERIFICATION_ATTEMPT_ENABLED=false
GOTRUE_HOOK_MFA_VERIFICATION_ATTEMPT_URI=pg-functions://postgres/virtual_ink_auth_guard/mfa_verification_attempt
# Review all thirteen migrations and the isolated DB markers before activation.
# Native Auth retains its existing DB identity and encrypted-secret configuration.
# Do not copy native Auth, migration or provisioning credentials into web envs.
# The local synthetic harness raises its shared-IP limit to isolate race tests;
# that fixture setting is intentionally absent from this deployment template.
