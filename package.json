{
  "name": "virtual-ink",
  "version": "0.1.0",
  "private": true,
  "description": "Virtual Ink modular TypeScript backend foundation and application starter",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "lint": "eslint src scripts test apps/web eslint.config.mjs --max-warnings 0",
    "lint:web": "eslint apps/web --max-warnings 0",
    "check:environment": "node scripts/environment-isolation-check.mjs",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-isolation=none \"test/*.test.*\"",
    "test:coverage": "node scripts/test-coverage.mjs",
    "security:check": "node scripts/security-check.ts",
    "security:runtime": "node scripts/security-runtime.ts",
    "test:security": "node --test --test-isolation=none test/security.test.ts test/security-check.test.ts test/identity.test.ts test/memberships.test.ts test/backend.test.ts test/app.test.js test/database-config.test.ts test/database-pool.test.ts test/transport-boundaries.test.ts test/coverage-policy.test.mjs test/provisioning.test.ts test/setup.test.ts test/supabase-rest.test.ts test/design-workspace.test.ts test/vendor-application.test.ts test/vendor-onboarding.test.ts test/web-auth.test.ts test/service-binding.test.ts test/vercel-runtime.test.js test/phase1-permissions.test.ts test/phase1-context.test.ts test/assigned-context.test.ts test/step-up.test.ts test/security-admin.test.ts test/environment-isolation.test.ts",
    "dev:services": "vercel dev --local --listen 127.0.0.1:3100",
    "test:auth:web": "node --test --test-isolation=none scripts/web-auth-checks.mjs",
    "check:security:auth:local": "node --max-old-space-size=256 --max-semi-space-size=2 scripts/genuine-mfa-local-check.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test:web": "node --test --test-isolation=none scripts/web-ui-checks.mjs scripts/brand-ui-checks.mjs scripts/account-ui-checks.mjs",
    "check:web:http": "node scripts/web-http-checks.mjs",
    "check:auth:http": "node scripts/web-auth-http-checks.mjs",
    "check:services:http": "node scripts/vercel-services-http-checks.mjs",
    "check:hosted": "node scripts/hosted-smoke.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.ts migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/database.ts seed",
    "test:db": "node --env-file-if-exists=.env scripts/database.ts test",
    "jobs:once": "node --env-file-if-exists=.env scripts/database.ts probe",
    "admin:provision": "node --env-file-if-exists=.private/provisioning.env scripts/provision.ts",
    "test:auth:live": "node --env-file-if-exists=.env scripts/auth-smoke.ts",
    "setup:check": "node scripts/setup-check.ts",
    "setup:init": "node scripts/setup-init.ts"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
